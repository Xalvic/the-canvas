[Unit]
Description=Scribble unfinished-upload cleanup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=scribble
WorkingDirectory=/opt/scribble
ExecStart=/usr/bin/docker compose --env-file /opt/scribble/.env.production -f deployment/compose.production.yaml run --rm --no-deps api cleanup
TimeoutStartSec=300
