{
  "name": "the-canvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:check:docker": "node --env-file=.env.docker node_modules/prisma/build/index.js migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "dev": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:server:docker": "tsx watch --env-file=.env.docker server/index.ts",
    "db:migrate": "tsx --env-file-if-exists=.env server/migrate.ts",
    "db:migrate:docker": "tsx --env-file=.env.docker server/migrate.ts",
    "db:start": "node scripts/local-postgres.mjs start",
    "db:setup": "node scripts/setup-postgres.mjs",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:status": "node scripts/local-postgres.mjs status",
    "assets:cleanup": "tsx --env-file-if-exists=.env server/cleanupAssets.ts",
    "assets:cleanup:docker": "tsx --env-file=.env.docker server/cleanupAssets.ts",
    "test:database": "node --env-file-if-exists=.env scripts/test-database.mjs",
    "test:database:docker": "node --env-file=.env.docker scripts/test-database.mjs",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start:server": "node --env-file-if-exists=.env dist-server/index.js",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:server": "vitest run server",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test -c playwright.integration.config.ts"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.12.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "^5.104.1",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^1.43.0",
    "perfect-freehand": "1.2.3",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5",
    "zustand": "^5.0.8"
  },
  "overrides": {
    "@prisma/config": { "deepmerge-ts": "8.0.2" },
    "prisma": { "mysql2": "3.24.5" }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
