# Copy to ignored .env.production. Enter secrets locally, never in chat/Git/VITE_.
DEPLOYMENT_ENV=production
API_HOST=0.0.0.0
API_PORT=3001
DATABASE_URL=postgresql://APP_ROLE:ENCODED_PASSWORD@YOUR-NEON-HOST-pooler.neon.tech/scribble?sslmode=verify-full
DIRECT_DATABASE_URL=postgresql://APP_ROLE:ENCODED_PASSWORD@YOUR-NEON-HOST.neon.tech/scribble?sslmode=verify-full
AUTH_FRONTEND_URL=https://milanputhukkudy.com/scribble/
GOOGLE_REDIRECT_URI=https://milanputhukkudy.com/api/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_LOCALLY
SCRIBBLE_PROXY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
IMAGEKIT_PRIVATE_KEY=REPLACE_WITH_RESTRICTED_PRIVATE_KEY_LOCALLY
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/scribblemilan/
IMAGEKIT_FOLDER=scribble/production
# Only used by Compose interpolation, not sent to the browser.
API_ORIGIN_HOST=api-origin.YOUR_DOMAIN
SCRIBBLE_API_IMAGE=scribble-api:REVIEWED_COMMIT_SHA
# Backup key/configuration: see docs/backups.md. Backups use the direct URL.
# BACKUP_ENCRYPTION_KEY=GENERATE_AND_STORE_SEPARATELY_FROM_BACKUPS
