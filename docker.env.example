# Copy to .env.docker for PostgreSQL-only Compose; keep real passwords out of Git.
# Use separate random passwords. The app password must also match DATABASE_URL.
# URL-encode special characters in DATABASE_URL; generated hex needs no encoding.
POSTGRES_PASSWORD=YOUR_DOCKER_ADMIN_PASSWORD
SCRIBBLE_DB_PASSWORD=YOUR_DOCKER_APP_PASSWORD
DATABASE_URL=postgresql://scribble:YOUR_DOCKER_APP_PASSWORD@127.0.0.1:5434/scribble
API_PORT=3001
