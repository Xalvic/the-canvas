# Backend only. Copy to .env and fill in your local connection details.
# Credentials must never use a VITE_ prefix or enter frontend code.
DATABASE_URL=postgresql://scribble:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/scribble
API_PORT=3001

# Optional Google-only sign-in. Leave all three GOOGLE_ settings unset to disable.
# Create a Google OAuth Web application client; keep its secret backend-only.
# GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=YOUR_WEB_CLIENT_SECRET
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/auth/google/callback
# AUTH_FRONTEND_URL=http://127.0.0.1:5173/scribble/
