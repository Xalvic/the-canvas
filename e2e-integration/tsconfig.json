{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client"],
    "baseUrl": "..",
    "paths": { "/scribble/src/*": ["src/*"] }
  },
  "include": ["*.ts", "../scripts/e2e-api-fixture.ts", "../playwright.integration.config.ts"]
}
